ANTHROPIC_API_KEY=
CJ_API_KEY=
CJ_API_EMAIL=
SUPABASE_URL=
SUPABASE_KEY=

# When MOCK_MODE=true the pipeline uses fixtures in backend/mock_data
# instead of calling pytrends / CJ / Claude / Supabase. Use this while
# iterating on the frontend so we don't burn API calls.
MOCK_MODE=true

# When DEMO_MODE=true the pipeline reads `backend/demo_input.yaml` for
# hand-curated trends + products, skips all external API calls (pytrends,
# CJ, LLM, Supabase), runs Step 4 (margin math) and Step 5 (rules-based
# recommendation, no LLM), and writes results to backend/mock_data so the
# dashboard renders them. Use this for offline demos.
DEMO_MODE=false
